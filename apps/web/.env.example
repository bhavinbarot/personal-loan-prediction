# Public origin of the FastAPI service, inlined into the browser bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional server-only override used by server components (for example an internal
# container address). Falls back to NEXT_PUBLIC_API_BASE_URL when unset.
# API_BASE_URL=http://api:8000

# Optional canonical site origin used for absolute OpenGraph URLs.
# NEXT_PUBLIC_SITE_URL=https://example.com
