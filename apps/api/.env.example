# Path to the trained model bundle. Defaults to <repo>/artifacts/model.joblib.
# LOAN_MODEL_PATH=/path/to/model.joblib

# Directory containing the tracked validation reports. Defaults to <repo>/reports.
# LOAN_REPORTS_DIR=/path/to/reports

# Comma-separated list of browser origins allowed to call the API.
# Defaults to the local Next.js dev server.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
